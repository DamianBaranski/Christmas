# Copy to .env and fill in. .env is ignored by git.

# Long random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 1 only on your own computer
DEBUG=0

# Comma separated domains the site is served on
ALLOWED_HOSTS=swieta.ebaranski.pl
CSRF_TRUSTED_ORIGINS=https://swieta.ebaranski.pl

# Who gets "approve this person?" emails
ORGANISER_EMAIL=

# SMTP. Leave EMAIL_HOST empty to print emails to the console instead of sending.
# For Gmail use an app password: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
