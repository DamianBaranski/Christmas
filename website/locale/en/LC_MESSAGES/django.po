#: draw.py:30 templates/website/panel.html:133
msgid "Do losowania potrzeba co najmniej 2 potwierdzonych osób."
msgstr "At least 2 confirmed people are needed for the draw."

#: draw.py:38
msgid ""
"Nie udało się znaleźć losowania spełniającego wszystkie blokady. Usuń część "
"blokad w panelu."
msgstr ""
"Couldn't find a draw that satisfies all exclusions. Remove some exclusions "
"in the panel."

#: draw.py:44
msgid "Wyniki losowania"
msgstr "Secret Santa draw results"

#: draw.py:46
#, python-brace-format
#| msgid ""
#| "{giver},\n"
#| "\n"
#| "Święty Mikołaj nie da rady samemu obdarować wszystkich, musisz mu pomóc.\n"
#| "Zrób prezent dla: {receiver} (do kwoty 50 zł).\n"
#| "Pod tym adresem sprawdzisz, czy wylosowana osoba przesłała list: {check_url}\n"
#| "Jeśli jeszcze nie przesłałeś(-aś) swojego listu, możesz to zrobić tutaj: {wishlist_url}\n"
#| "\n"
#| "Pozdrawiam\n"
#| "Święty Mikołaj\n"
msgid ""
"{giver},\n"
"\n"
"Święty Mikołaj nie da rady samemu obdarować wszystkich, musisz mu pomóc.\n"
"Zrób prezent dla: {receiver} (budżet: {budget}).\n"
"Pod tym adresem sprawdzisz, czy wylosowana osoba przesłała list: {check_url}\n"
"Jeśli jeszcze nie przesłałeś(-aś) swojego listu, możesz to zrobić tutaj: {wishlist_url}\n"
msgstr ""
"{giver},\n"
"\n"
"Santa can't bring presents to everyone on his own, so he needs your help.\n"
"Please prepare a gift for: {receiver} (budget: {budget}).\n"
"You can check whether they sent a letter to Santa here: {check_url}\n"
"If you haven't sent your own letter yet, you can do it here: {wishlist_url}\n"

#: draw.py:60
msgid "Do zobaczenia na wigilii!"
msgstr "See you on Christmas Eve!"

#: draw.py:61
#| msgid "Zostań Świętym Mikołajem!"
msgid ""
"Pozdrawiam\n"
"Święty Mikołaj"
msgstr ""
"Best wishes,\n"
"Santa Claus"

